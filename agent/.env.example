# Shared secret. Must match the cloud relay. Generate with: openssl rand -hex 24
PAIRING_TOKEN=
# wss:// URL of the relay's /agent endpoint
RELAY_URL=wss://your-app.onrender.com/agent
# Folder with your videos/music (~ is expanded)
MEDIA_DIR=~/Movies
# LAN port the monitor streams from
HTTP_PORT=8200
# Optional: override the auto-detected LAN IP
# AGENT_HOST=192.168.1.50
# Ping the relay's /healthz every N minutes so free hosting doesn't sleep (0 = off)
KEEPALIVE_MINUTES=10
